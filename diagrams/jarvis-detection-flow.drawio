<mxfile host="app.diagrams.net">
  <diagram name="Device detection flow" id="detection">
    <mxGraphModel dx="800" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="capture" value="Capture ARP traffic&lt;br&gt;&lt;i style=&quot;font-size:11px;&quot;&gt;Passive, no probing&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="260" y="130" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="decision" value="Registered device?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="240" y="240" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="update" value="Update last seen&lt;br&gt;&lt;i style=&quot;font-size:11px;&quot;&gt;No alert raised&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="alert" value="Raise alert&lt;br&gt;&lt;i style=&quot;font-size:11px;&quot;&gt;Push to phone&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="400" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="homeowner" value="Homeowner decides&lt;br&gt;&lt;i style=&quot;font-size:11px;&quot;&gt;System never acts&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="510" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="end" value="End" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="510" y="620" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="capture">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="capture" target="decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;verticalAlign=bottom;" edge="1" parent="1" source="decision" target="update">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;verticalAlign=bottom;" edge="1" parent="1" source="decision" target="alert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="alert" target="homeowner">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="homeowner" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="update" target="capture">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="20" y="430" />
              <mxPoint x="20" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
